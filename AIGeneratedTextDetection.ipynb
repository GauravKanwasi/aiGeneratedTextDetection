# Cell 1: Import necessary libraries
from transformers import GPT2LMHeadModel, GPT2Tokenizer
from collections import OrderedDict
import re
import nltk
from nltk.tokenize import sent_tokenize

# Cell 2: Load pre-trained GPT model and tokenizer
model_name = "gpt2"  # You can change this to another GPT variant (e.g., 'gpt2-medium')
model = GPT2LMHeadModel.from_pretrained(model_name)
tokenizer = GPT2Tokenizer.from_pretrained(model_name)

# Cell 3: Define the function to calculate perplexity
def calculate_perplexity(text):
    # Tokenize the text into input IDs (tokens)
    input_ids = tokenizer.encode(text, return_tensors="pt")

    # Get model output and calculate loss (perplexity is the exponentiation of the loss)
    outputs = model(input_ids, labels=input_ids)
    loss = outputs.loss
    perplexity = loss.exp().item()  # Convert the loss into perplexity value

    return perplexity

# Cell 4: Define the function to classify based on perplexity
def getResults(perplexity):
    # Set thresholds for classification
    threshold1 = 60  # Threshold for high likelihood of AI-generated text
    threshold2 = 80  # Threshold for possible AI-generated text

    if perplexity < threshold1:
        # If perplexity is low, the text is likely AI-generated
        return "The Text is generated by AI.", 0
    elif perplexity < threshold2:
        # If perplexity is in the middle range, the text might contain AI-generated parts
        return "The Text most probably contains parts generated by AI. (Requires more text for better judgment)", 0
    else:
        # If perplexity is high, the text is more likely human-written
        return "The Text is written by a Human.", 1

# Cell 5: Define the function to predict the text's origin
def predict(sentence):
    results = OrderedDict()

    # Tokenize the input sentence into individual sentences (useful for analyzing smaller chunks of text)
    lines = sent_tokenize(sentence)
    Perplexity_per_line = []
    
    for line in lines:
        # Calculate perplexity for each sentence
        ppl = calculate_perplexity(line)
        Perplexity_per_line.append(ppl)
    
    # Calculate the average perplexity of the whole paragraph
    average_perplexity = sum(Perplexity_per_line) / len(Perplexity_per_line)
    results["Average Perplexity of whole paragraph"] = average_perplexity

    # Classify based on the calculated average perplexity
    result_text, label = getResults(average_perplexity)
    results["label"] = label

    # Print the average perplexity and result
    print(f"Average Perplexity of whole paragraph: {average_perplexity}")
    return result_text

# Cell 6: Download necessary NLTK resources for sentence tokenization
nltk.download('punkt')

# Cell 7: Test with example texts
test_texts = [
    '''
